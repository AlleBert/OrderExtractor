  "components": {
    "schemas": {
      "Activation": {
        "properties": {
          "serial": {
            "type": "string",
            "maxLength": 128,
            "minLength": 12,
            "title": "Serial"
          },
          "device_key": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "Device Key"
          },
          "label": {
            "type": "string",
            "maxLength": 80,
            "title": "Label",
            "default": ""
          },
          "version": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9A-Za-z.+-]+$",
            "title": "Version"
          },
          "proof": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$",
            "title": "Proof"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "serial",
          "device_key",
          "version",
          "proof"
        ],
        "title": "Activation"
      },
      "Batch": {
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/Event"
            },
            "type": "array",
            "maxItems": 40,
            "minItems": 1,
            "title": "Events"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "events"
        ],
        "title": "Batch"
      },
      "CustomerChange": {
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^(active|suspended)$",
            "title": "Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status"
        ],
        "title": "CustomerChange"
      },
      "CustomerInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 180,
            "minLength": 1,
            "title": "Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "name"
        ],
        "title": "CustomerInput"
      },
      "Event": {
        "properties": {
          "event_id": {
            "type": "string",
            "format": "uuid",
            "title": "Event Id"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "event_code": {
            "type": "string",
            "enum": [
              "PDF_INVALID",
              "EXPORT_SUCCESS",
              "COLUMN_UNMAPPED"
            ],
            "title": "Event Code"
          },
          "severity": {
            "type": "string",
            "enum": [
              "info",
              "warning"
            ],
            "title": "Severity"
          },
          "app_version": {
            "type": "string",
            "maxLength": 24,
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "title": "App Version"
          },
          "page_count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 100.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Count"
          },
          "row_count": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 1500.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Row Count"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "event_id",
          "timestamp",
          "event_code",
          "severity",
          "app_version"
        ],
        "title": "Event"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LicenseChange": {
        "properties": {
          "status": {
            "type": "string",
            "pattern": "^(active|suspended|revoked)$",
            "title": "Status",
            "default": "active"
          },
          "seats": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Seats"
          },
          "offline_days": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Offline Days"
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "channel": {
            "type": "string",
            "pattern": "^(dev|beta|stable)$",
            "title": "Channel"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "seats",
          "offline_days",
          "valid_until",
          "channel"
        ],
        "title": "LicenseChange"
      },
      "LicenseInput": {
        "properties": {
          "customer_id": {
            "type": "string",
            "maxLength": 64,
            "title": "Customer Id"
          },
          "seats": {
            "type": "integer",
            "maximum": 1000.0,
            "minimum": 1.0,
            "title": "Seats",
            "default": 1
          },
          "offline_days": {
            "type": "integer",
            "maximum": 7.0,
            "minimum": 1.0,
            "title": "Offline Days",
            "default": 7
          },
          "valid_until": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 2147483647.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Valid Until"
          },
          "channel": {
            "type": "string",
            "pattern": "^(dev|beta|stable)$",
            "title": "Channel",
            "default": "stable"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "customer_id"
        ],
        "title": "LicenseInput"
      },
      "Proof": {
        "properties": {
          "challenge": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{43}$",
            "title": "Challenge"
          },
          "signature": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{86}$",
            "title": "Signature"
          },
          "version": {
            "type": "string",
            "maxLength": 40,
            "pattern": "^[0-9A-Za-z.+-]+$",
            "title": "Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "challenge",
          "signature",
          "version"
        ],
        "title": "Proof"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
