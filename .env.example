OE_DATABASE=postgresql+psycopg://order:password-from-secret-store@postgres/order
OE_SIGNING_KEY=/run/secrets/license-signing.pem
OE_PEPPER=
OE_OIDC_ISSUER=
OE_OIDC_AUDIENCE=
OE_OIDC_JWKS=
# Claim sub dell’unico proprietario se si usa infra/private-admin.compose.yaml.
OE_ADMIN_SUBJECT=
# Origine HTTPS della console per abilitare il login OIDC dal browser.
OE_ADMIN_ORIGIN=
OE_CONTROL_URL=
OE_LEASE_PUBLIC_KEY=
OE_HOSTNAME=
POSTGRES_PASSWORD=
OE_BIND=0.0.0.0
OE_HOST_KEY_FILE=
# Optional TUF repository, enabled through infra/updates.compose.yaml.
OE_HOST_UPDATES_ROOT=
# Trusted initial root for a client launched directly from source.
OE_UPDATE_TRUSTED_ROOT=
